# Cloudflare Worker URL (e.g., https://landing-live-status.your-subdomain.workers.dev)
CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev

# Secret Bearer Token matching AUTH_SECRET in Cloudflare Worker
AUTH_SECRET=your-custom-secret-token

# Optional: Override current task or category manually if not reading from file
# HERMES_CURRENT_TASK=Building Live Command Center
# HERMES_CATEGORY=Frontend
