name = "landing-live-status"
main = "worker.js"
compatibility_date = "2024-09-01"

# Bind your KV Namespace
# Run: wrangler kv:namespace create STATUS_KV
# Then paste the returned id here:
[[kv_namespaces]]
binding = "STATUS_KV"
id = "YOUR_KV_NAMESPACE_ID"

[vars]
AUTH_SECRET = "your_secret_auth_token"
TELEGRAM_BOT_TOKEN = "your_telegram_bot_token"
TELEGRAM_CHAT_ID = "your_telegram_chat_id"
